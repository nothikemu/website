# Everything here is server-side only (read by /api routes). Nothing is bundled into the site.
# Set these in Vercel → Project → Settings → Environment Variables.

# --- Spotify (recently played + fallback now-playing) ---
# Create an app at https://developer.spotify.com/dashboard and add the redirect URI
#   https://<your-domain>/api/spotify/callback   (and http://127.0.0.1:5173/api/spotify/callback for local dev)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Any long random string. Visit /api/spotify/login?key=<this> once to authorize.
SPOTIFY_SETUP_KEY=
# Shown to you after authorizing. Paste it here / into Vercel and redeploy.
SPOTIFY_REFRESH_TOKEN=
# Optional: override the computed redirect URI.
# SPOTIFY_REDIRECT_URI=

# --- GitHub (optional; raises the API rate limit for /api/github) ---
# A fine-grained token with no extra permissions is enough.
GITHUB_TOKEN=

# --- Steam (optional; live presence + recently played on /more) ---
STEAM_API_KEY=
# Optional: skip the vanity-name lookup.
# STEAM_ID64=
