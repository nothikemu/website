# ─── Core ──────────────────────────────────────────────────────────────
# Public base URL of the app (used for OAuth callbacks, emails, signed URLs)
APP_URL=http://localhost:3000
# PostgreSQL connection string. On Supabase use the pooled (6543) URL for the app.
DATABASE_URL=postgres://forgebase:forgebase@localhost:5432/forgebase
# 32+ random bytes, base64 or hex. Generate: openssl rand -base64 48
AUTH_SECRET=
# Key for encrypting stored third-party tokens & webhook secrets (AES-256-GCM).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# ─── OAuth (optional — buttons are hidden when unset) ──────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Object storage ────────────────────────────────────────────────────
# "local" (filesystem, dev only) or "s3" (AWS S3, Cloudflare R2, Supabase Storage S3, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ─── Email ─────────────────────────────────────────────────────────────
# "console" logs emails to the server log (dev). "smtp" sends via SMTP_URL.
EMAIL_DRIVER=console
SMTP_URL=
EMAIL_FROM="Forgebase <no-reply@forgebase.local>"

# ─── Forge AI (optional) ───────────────────────────────────────────────
# none | openai | anthropic | google
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─── Observability ─────────────────────────────────────────────────────
LOG_LEVEL=info
# Error tracking DSN (Sentry-compatible). Leave empty to log only.
ERROR_TRACKING_DSN=
